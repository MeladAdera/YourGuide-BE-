# Used only by the e2e tests. Safe to commit: local Docker credentials only.
# The database name must end with _test (the test setup refuses anything else).
DATABASE_URL=postgres://your_guide:your_guide@localhost:5433/your_guide_test

# Never sent anywhere: every e2e test replaces the model with a fake
# (test/helpers/create-test-app.ts). The config still requires the variable,
# so startup keeps one rule for every environment.
MISTRAL_API_KEY=test-key-never-sent
