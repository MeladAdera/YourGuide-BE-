# Copy this file to .env and adjust if needed.
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://your_guide:your_guide@localhost:5433/your_guide_dev

# Optional. Defaults to 3001 (the web app uses 3000).
PORT=3001

# Optional. How many proxies sit in front of the API (hosting platform,
# Next.js rewrites). Defaults to 0. Needed in production so the rate limit
# counts the real client IP (from X-Forwarded-For) and not the proxy's.
# TRUST_PROXY=1

# Which provider writes the AI advice behind "I'm struggling": mistral (default)
# or groq. The chosen provider's key below is required; the app refuses to
# start without it. The key is used from the backend only and never reaches
# the browser.
# AI_PROVIDER=mistral

# Mistral: console.mistral.ai → API Keys → Create new key (free plan, no card).
MISTRAL_API_KEY=

# Groq, only when AI_PROVIDER=groq: console.groq.com → API Keys.
# GROQ_API_KEY=

# Optional. The model that writes the advice. Defaults to mistral-medium-latest
# on Mistral and openai/gpt-oss-120b on Groq.
# AI_MODEL=mistral-medium-latest

# Optional. How many struggles one user may send to the model per day, counted
# in the user's own timezone. Defaults to 10. Past it the API answers 429.
# AI_DAILY_LIMIT=10

# Optional. How long one advice call may take, retries included, in
# milliseconds. Defaults to 20000. Past it the API answers 503.
# AI_TIMEOUT_MS=20000
