# Copy this file to .env and adjust if needed.
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://your_guide:your_guide@localhost:5433/your_guide_dev

# Optional. Defaults to 3001 (the web app uses 3000).
PORT=3001

# Optional. How many proxies sit in front of the API (hosting platform,
# Next.js rewrites). Defaults to 0. Needed in production so the rate limit
# counts the real client IP (from X-Forwarded-For) and not the proxy's.
# TRUST_PROXY=1

# The Groq API key (console.groq.com → API Keys). The AI advice behind
# "I'm struggling" is requested with it, from the backend only: it never
# reaches the browser. The app refuses to start without it.
GROQ_API_KEY=

# Optional. The model that writes the advice. Defaults to openai/gpt-oss-120b.
# AI_MODEL=openai/gpt-oss-120b

# Optional. How many struggles one user may send to the model per day, counted
# in the user's own timezone. Defaults to 10. Past it the API answers 429.
# AI_DAILY_LIMIT=10

# Optional. How long one advice call may take, retries included, in
# milliseconds. Defaults to 20000. Past it the API answers 503.
# AI_TIMEOUT_MS=20000
