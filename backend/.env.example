# Copy this file to .env and adjust if needed.
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://your_guide:your_guide@localhost:5433/your_guide_dev

# Optional. Defaults to 3001 (the web app uses 3000).
PORT=3001

# Optional. How many proxies sit in front of the API (hosting platform,
# Next.js rewrites). Defaults to 0. Needed in production so the rate limit
# counts the real client IP (from X-Forwarded-For) and not the proxy's.
# TRUST_PROXY=1
