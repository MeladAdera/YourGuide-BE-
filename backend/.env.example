# Copy this file to .env and adjust if needed.
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://your_guide:your_guide@localhost:5433/your_guide_dev

# Optional. Defaults to 3001 (the web app uses 3000).
PORT=3001

# Optional. How many proxies sit in front of the API (hosting platform,
# Next.js rewrites). Defaults to 0. Needed in production so the rate limit
# counts the real client IP (from X-Forwarded-For) and not the proxy's.
# TRUST_PROXY=1

# Which provider writes the AI advice behind "I'm struggling". The chosen
# provider's key below is required (except `compatible`, where it is
# optional); the app refuses to start without it. Keys are used from the
# backend only and never reach the browser.
#   zai (default)  Z.ai's free GLM-4.7-Flash: z.ai → API keys.
#   compatible     Any OpenAI-style endpoint, by AI_BASE_URL: a local Ollama
#                  (http://127.0.0.1:11434/v1, no key), Ollama cloud
#                  (https://ollama.com/v1), Cloudflare Workers AI, Qwen, DeepSeek.
#   mistral        console.mistral.ai → API Keys (needs an activated plan).
#   groq           console.groq.com → API Keys (not served everywhere).
# AI_PROVIDER=zai
ZAI_API_KEY=
# AI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# For `compatible`, required: the endpoint up to and excluding /chat/completions.
# For `zai`, optional: overrides https://api.z.ai/api/paas/v4.
# AI_BASE_URL=http://127.0.0.1:11434/v1

# The model that writes the advice. Defaults: glm-4.5-flash (zai),
# mistral-medium-latest (mistral), openai/gpt-oss-120b (groq). Required for
# `compatible`.
# AI_MODEL=glm-4.5-flash

# Optional. How many struggles one user may send to the model per day, counted
# in the user's own timezone. Defaults to 10. Past it the API answers 429.
# AI_DAILY_LIMIT=10

# Optional. How long one advice call may take, retries included, in
# milliseconds. Defaults to 45000: on the free tier a full prompt usually
# answers in 5–10 s, but one answer in eight took 42 s when measured.
# AI_TIMEOUT_MS=45000
